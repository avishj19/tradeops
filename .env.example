# Process environment; .env is not automatically loaded.
TRADEOPS_DATA=./data
# Optional AWS integration. Use role/profile credentials.
AWS_REGION=us-east-1
RAW_BUCKET=your-versioned-raw-bucket
OPTIMIZED_BUCKET=your-optimized-bucket
GLUE_JOB=tradeops-transform
ATHENA_WORKGROUP=tradeops

# Embedded AWS workflow (optional live mode)
# TRADEOPS_AWS_LIVE=1
# TRADEOPS_AWS_RAW_BUCKET=your-raw-bucket
# TRADEOPS_AWS_OPTIMIZED_BUCKET=your-optimized-bucket
# TRADEOPS_AWS_GLUE_JOB=tradeops-transform
# TRADEOPS_AWS_ATHENA_WORKGROUP=tradeops
# TRADEOPS_AWS_EVENT_BUS=default
# AWS_REGION=us-east-1
